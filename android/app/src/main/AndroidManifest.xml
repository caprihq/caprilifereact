<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Voice capture (@react-native-voice/voice). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Runtime notification permission, required from Android 13 (API 33). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ package visibility: without these the speech recogniser
         and the OAuth custom tab are invisible to the app and both fail with
         a generic "not available" rather than a useful error. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!--
      Predictive back is OFF (`enableOnBackInvokedCallback="false"`), deliberately.

      With it on, Android 13+ routes the back gesture and button through
      `OnBackInvokedDispatcher` instead of calling `Activity.onBackPressed()`. Nothing
      in the JS layer is consulted on that path, so React Navigation never popped and
      `BackHandler` never fired: back finished the activity from every screen, pushed
      ones included, which read as the app crashing on back.

      Off, the legacy path is restored — the stack pops, and the root screens can ask
      before closing (`useConfirmExit`). The cost is the system's predictive-back
      animation, which is not worth a back button that destroys the app. Revisit when
      RN and react-native-screens support the new dispatcher end to end, and re-test
      popping, tab-to-tab back, and the exit prompt.
    -->
    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:enableOnBackInvokedCallback="false"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/BootTheme"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>

        <!-- capri://auth — where Base44's provider login lands, via the redirect
             the deployed page performs. Must match base44Config.authCallbackScheme;
             configConstants.test.ts fails if they drift. Google and Apple only —
             email sign-in is a direct API call and needs none of this. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="capri" />
        </intent-filter>
      </activity>
    </application>
</manifest>
