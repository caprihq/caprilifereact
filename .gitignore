# Dependencies
node_modules/

# Metro / JS build output
.metro-health-check*
*.jsbundle
coverage/
*.tsbuildinfo
.eslintcache

# Android build output. These are large — `android/app/build` alone reaches ~3 GB
# and `.cxx` another ~700 MB — and every byte of it is regenerated by a build.
android/build/
android/app/build/
android/.gradle/
android/app/.cxx/
android/.idea/
*.hprof

# Machine-specific: written by Android Studio with this machine's SDK path.
android/local.properties

# Signing. `debug.keystore` is the shared debug key React Native ships and is meant
# to be committed; a real release key must never be.
*.jks
*.keystore
!android/app/debug.keystore

# iOS
ios/Pods/
ios/build/
ios/DerivedData/
# Written by the RN scripts with this machine's node path.
ios/.xcode.env.local
# Generated by `pod install`; `Podfile` and `Podfile.lock` are the sources of truth.
ios/*.xcworkspace
**/xcuserdata/
*.xcuserstate
*.mobileprovision
*.p8
*.p12
*.cer

# Firebase — supplied per environment, contains project identifiers
GoogleService-Info.plist
google-services.json

# Env
.env
.env.*
!.env.example

# Ruby / CocoaPods
vendor/bundle/

# Editors
.idea/
*.iml
*.swp

# macOS
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Working notes for the AI assistant, not project documentation. They describe how
# to work in this repo rather than what it does, and they change constantly.
CLAUDE.md
CODING_GUIDELINES.md

# Working documents — not part of the app
AI-Feature.md
Backlog.md
Client-Update.md
Scheduling-Design.md
incomplete.md
Technical-Documentation.html
CAPRI-Technical-Documentation.pdf
