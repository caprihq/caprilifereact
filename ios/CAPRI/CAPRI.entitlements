<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared container for NON-SECRET data the home-screen widget needs.
	     The session token is NOT here — it lives in the Keychain group below.
	     Must also be enabled on the widget extension target. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.base69aa4c4d4f33993320ae7f08.app</string>
	</array>
	<!-- Keychain group shared with the widget extension, so the token has one
	     home instead of a second plaintext copy in App Group UserDefaults.

	     Deliberately a single entry: with no kSecAttrAccessGroup passed at
	     runtime, iOS files items under the FIRST group listed here, and a JS
	     caller cannot name the group itself — the real value needs the team
	     prefix that $(AppIdentifierPrefix) expands to at build time.

	     The widget extension needs this same entry to read the token. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.base69aa4c4d4f33993320ae7f08.app.shared</string>
	</array>
	<!-- NO associated domain, deliberately.

	     An applinks entry for capriforlifev1.base44.app was here so the password-reset
	     email would open the app. Base44's apple-app-site-association claims
	     `paths: ["*"]` for this bundle id and cannot be narrowed from our side, so
	     the entitlement made EVERY https link on that host a Universal Link — including
	     `/api/external-auth/callback`, where Google sends the user back after the
	     calendar consent screen. iOS handed that redirect to the app instead of
	     loading it, Base44 never received the authorization code, and "Connect
	     Google Calendar" spun forever. The reset email now opens the web client's
	     own /reset-password page, which works. Android keeps its App Link because
	     the manifest can limit it to that one path. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
